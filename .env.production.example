# Copy to .env (same directory as docker-compose.prod.yml) and fill in real
# values before running: docker compose -f docker-compose.prod.yml up -d --build

# Postgres (defaults are fine for a single-server deploy; override if you're
# pointing at a managed Postgres instead of the bundled container)
POSTGRES_USER=utado
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=utado

# Auth - generate real random values, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m

# Must be the real public origin the frontend is served from
CORS_ORIGIN=https://utado.example.com

# Must be the real public URL of the backend API - baked into the frontend's
# client bundle at build time, so changing this later requires a rebuild
NEXT_PUBLIC_API_URL=https://api.utado.example.com/api/v1

# Optional - leave blank to run without avatar uploads (see "Media storage" in README)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
