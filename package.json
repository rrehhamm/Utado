{
  "name": "utado",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace packages/shared",
    "dev:backend": "npm run dev --workspace packages/backend",
    "dev:frontend": "npm run dev --workspace packages/frontend",
    "migrate": "npm run migrate --workspace packages/backend",
    "seed": "npm run seed --workspace packages/backend",
    "build:shared": "npm run build --workspace packages/shared"
  }
}
